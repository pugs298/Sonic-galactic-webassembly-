+#elif defined(__EMSCRIPTEN__)
+	// The browser owns the event loop, so MainLoop() must be driven by
+	// requestAnimationFrame instead of a blocking while loop.
+	LastTick = Clock::GetTicks();
+	WebFrameAccumulator = 0.0;
+	WebLastRAF = LastTick;
+
+	emscripten_set_main_loop_arg(WebMainLoopCallback, NULL, 0, 1);
 #else
 	LastTick = Clock::GetTicks();
 
