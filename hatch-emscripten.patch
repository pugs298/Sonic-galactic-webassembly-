diff -ruN a/cmake/Platforms/Emscripten.cmake b/cmake/Platforms/Emscripten.cmake
--- a/cmake/Platforms/Emscripten.cmake	1970-01-01 00:00:00.000000000 +0000
+++ b/cmake/Platforms/Emscripten.cmake	2026-11-13 11:23:02.978571195 +0000
@@ -0,0 +1,45 @@
+# Emscripten / WebAssembly platform file for Hatch Game Engine.
+# Selected automatically when configuring with the Emscripten toolchain
+# (CMAKE_SYSTEM_NAME == "Emscripten"), i.e. `emcmake cmake ...`.
+
+add_executable(${PROJECT_NAME} ${HATCH_SOURCES})
+target_compile_definitions(${PROJECT_NAME} PRIVATE -DHATCH_WEB)
+
+# Not available in this build:
+#  - The desktop OpenGL renderer (GLEW, GLSL 120/130, compatibility profile)
+#    can't run on WebGL. Without USING_OPENGL the engine falls back to its
+#    SDL2 renderer, which SDL maps to WebGL for us.
+#  - Open Asset Import Library, linenoise, Discord and libcurl are skipped.
+set(USING_OPENGL OFF CACHE BOOL "Use OpenGL" FORCE)
+set(USE_OPEN_ASSET_IMPORT_LIBRARY OFF CACHE BOOL "Use Open Asset Import Library" FORCE)
+
+set(CMAKE_EXECUTABLE_SUFFIX ".js")
+
+set(HATCH_WEB_COMMON_FLAGS
+  -sUSE_SDL=2
+  -fwasm-exceptions
+)
+
+set(HATCH_WEB_LINK_FLAGS
+  ${HATCH_WEB_COMMON_FLAGS}
+  # Memory: Data.hatch lives in the JS-side MEMFS, not in wasm memory, so the
+  # wasm heap only needs room for the engine, decoded textures and audio.
+  -sALLOW_MEMORY_GROWTH=1
+  -sINITIAL_MEMORY=268435456
+  -sMAXIMUM_MEMORY=2147483648
+  -sSTACK_SIZE=5242880
+  # Virtual filesystem (Data.hatch in MEMFS, saves/settings in IDBFS).
+  -sFORCE_FILESYSTEM=1
+  -lidbfs.js
+  -sEXPORTED_RUNTIME_METHODS=FS,addRunDependency,removeRunDependency
+  # One self-contained .js (wasm embedded as base64) that pack.py inlines
+  # into a single .html file.
+  -sSINGLE_FILE=1
+  -sMODULARIZE=1
+  -sEXPORT_NAME=createHatchModule
+  -sENVIRONMENT=web
+  -sEXIT_RUNTIME=0
+)
+
+target_compile_options(${PROJECT_NAME} PRIVATE ${HATCH_WEB_COMMON_FLAGS})
+target_link_options(${PROJECT_NAME} PRIVATE ${HATCH_WEB_LINK_FLAGS})
