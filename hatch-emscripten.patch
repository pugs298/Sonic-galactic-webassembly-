+	// Pacing is handled in WebMainLoopCallback; blocking here would freeze the tab.
+	return;
+#endif
 	double frameTime = Clock::GetTicks() - FrameTimeStart;
 	double frameDurationRemainder = FrameTimeDesired - frameTime;
 	if (frameDurationRemainder >= 0.0) {
@@ -2090,6 +2099,48 @@
 		Scene::FinishLoad();
 	}
 }
+#ifdef __EMSCRIPTEN__
+static double WebFrameAccumulator = 0.0;
+static double WebLastRAF = 0.0;
+
+// Called by requestAnimationFrame. Display refresh rates vary (60/120/144Hz),
+// so only run a game frame once enough time has accumulated for one frame at
+// the engine's target FPS. Otherwise the game would run too fast on
+// high-refresh displays.
+void Application::WebMainLoopCallback(void* userData) {
+	double now = Clock::GetTicks();
+	double elapsed = now - WebLastRAF;
+	WebLastRAF = now;
+
+	// Don't build up a huge backlog after the tab was in the background.
+	if (elapsed > FrameTimeDesired * 4.0) {
+		elapsed = FrameTimeDesired;
+	}
+
+	WebFrameAccumulator += elapsed;
+
+	// 1.5ms of slack so a 60Hz display against a 60 FPS target isn't
+	// randomly dropping frames due to timer jitter.
+	if (WebFrameAccumulator < FrameTimeDesired - 1.5) {
+		return;
+	}
+	WebFrameAccumulator -= FrameTimeDesired;
+	if (WebFrameAccumulator > FrameTimeDesired) {
+		WebFrameAccumulator = 0.0;
+	}
+
+	if (Running) {
+		MainLoopCallback(NULL);
+	}
+
+	if (!Running) {
+		emscripten_cancel_main_loop();
+		EndGame();
+		Cleanup();
+	}
+}
+#endif
